# ───────────────────────────────────────────────────────────────
# Risk (standalone) — environment configuration
# Copy to `.env` and edit before `docker compose up -d`.
# ───────────────────────────────────────────────────────────────

# PostgreSQL password (internal, used by the docker-compose DB).
#   openssl rand -hex 16
DB_PASSWORD=change-me

# ── Security ───────────────────────────────────────────────────
# ROOT secret, not a signing key. This module derives its own session
# signing key from it at startup:
#   HKDF-SHA256(JWT_SECRET, info="ciso-module:risk")
# so the raw secret never signs anything and a session minted by another
# module cannot be replayed here. Nothing else to configure. Changing this
# value rotates the key and logs every user out.
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Authentication mode:
#   standalone  (default) — local token login, see AUTH_TOKEN below
#   none                  — authentication DISABLED, every route served as
#                           admin. Dev/test ONLY. This is the *only* way to
#                           run without a credential: in any other mode the
#                           app refuses to boot with an empty credential
#                           rather than silently opening up.
AUTH_MODE=standalone

# Shared secret for the standalone login (`POST /auth/login/token`). The
# first account that logs in becomes admin; later ones are plain users an
# admin promotes. REQUIRED when AUTH_MODE=standalone.
#   openssl rand -hex 32
AUTH_TOKEN=change-me-to-a-long-random-token

# ── Data-at-rest encryption (recommended) ──────────────────────
# Encrypts the AI provider API keys you store in Settings
# before they are written to the database (AES-256-GCM).
# OPTIONAL for a standalone module: leave it unset and those secrets
# are stored in CLEARTEXT (the app logs a one-time warning to make
# that an explicit choice, not a silent one). Set it and existing
# rows migrate to ciphertext on their next write.
# Use a DEDICATED value, distinct from JWT_SECRET — reusing the
# session secret couples the session-forgery and data-at-rest trust
# domains. >= 32 chars. Rotating it makes secrets written under the
# old key unreadable; re-enter them after a rotation.
#   openssl rand -hex 32
# ENCRYPTION_KEY=change-me-to-a-dedicated-random-string

# ── Networking ─────────────────────────────────────────────────
# Public URL the app is reachable at. Must match what users type in their
# browser. The session cookie is Secure by DEFAULT: it is only sent over
# plain HTTP when this URL explicitly starts with `http://`. An empty or
# malformed value therefore fails secure (cookie marked Secure) instead of
# silently downgrading the session.
APP_URL=http://localhost:8085

# ── Optional: OAuth / OIDC providers ───────────────────────────
# Leave blank to disable. Register ${APP_URL}/auth/callback/<provider>
# as a redirect URI on the provider side.
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_TENANT_ID=common
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ISSUER=https://sso.example.com/realms/main
# OIDC_LABEL=SSO

# ── Optional: outbound HTTP proxy (corporate egress) ───────────
# For hosts with NO direct internet access that must reach outbound
# services (the LLM API; for Surface also the CVE feeds and scan probes)
# through a corporate forward proxy. When set, httpx routes EVERY
# outbound call this backend makes through the proxy — it reads these
# from the environment at request time, so no code change is needed.
# The PostgreSQL connection uses asyncpg (not httpx) and is NEVER proxied.
# NO_PROXY lists hosts to reach directly (bypassing the proxy).
# Leave all three empty for direct outbound access (the default).
#   HTTP_PROXY=http://proxy.corp.example:8080
#   HTTPS_PROXY=http://proxy.corp.example:8080
#   NO_PROXY=localhost,127.0.0.1
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
